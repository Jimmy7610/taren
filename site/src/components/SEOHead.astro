---
import { buildSeo, serializeJsonLd, type SeoInput } from '@/lib/seo';
import { SITE } from '@/config/site';
import { i18n } from '@/i18n';
import soraLatin from '@/assets/fonts/sora-subset.woff2?url';
import interLatin from '@/assets/fonts/inter-subset.woff2?url';

interface Props extends Omit<SeoInput, 'path' | 'locale'> {
  jsonLd?: unknown[];
}
const { jsonLd = [], ...input } = Astro.props;
const { locale } = i18n(Astro);
const meta = buildSeo({ ...input, path: Astro.url.pathname, locale });
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{meta.title}</title>
<meta name="description" content={meta.description} />
{meta.canonical && <link rel="canonical" href={meta.canonical} />}
{meta.alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
<meta name="robots" content={meta.robots} />
<meta name="theme-color" content="#0a1020" />
<meta name="color-scheme" content="dark" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap.xml" />

<link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={meta.ogLocale} />
{meta.ogLocaleAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
<meta property="og:type" content={meta.ogType} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
{meta.canonical && <meta property="og:url" content={meta.canonical} />}
<meta property="og:image" content={meta.ogImage} />
<meta property="og:image:alt" content={meta.ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.ogImage} />
<meta name="twitter:image:alt" content={meta.ogImageAlt} />

{jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={serializeJsonLd(data)} />)}
