---
/**
 * Button — always a link (every CTA on this site navigates). External links get a visible
 * arrow, an accessible "opens in a new tab" hint and rel="noopener noreferrer".
 */
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', external = false, class: className = '', ...rest } = Astro.props;
const variants = {
  primary:
    'bg-text text-ink hover:bg-cyan-soft shadow-[0_1px_0_rgb(255_255_255/0.4)_inset,0_10px_30px_-12px_rgb(53_213_255/0.55)]',
  secondary: 'border border-line-strong text-text hover:border-cyan/60 hover:bg-white/[0.04]',
  ghost: 'text-muted hover:text-text',
};
const sizes = { md: 'min-h-11 px-5 text-[0.9375rem]', lg: 'min-h-13 px-7 text-base' };
import { i18n } from '@/i18n';
const { t } = i18n(Astro);
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  class:list={[
    'group/btn inline-flex items-center justify-center gap-2 rounded-full font-medium tracking-[-0.005em] whitespace-nowrap transition-[background-color,border-color,color,transform] duration-300 ease-(--ease-out-quart) active:scale-[0.98]',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...externalAttrs}
  {...rest}
>
  <slot />
  {
    external ? (
      <>
        <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5 transition-transform duration-300 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5">
          <path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span class="sr-only">{t('common.newTab')}</span>
      </>
    ) : (
      <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5 transition-transform duration-300 group-hover/btn:translate-x-0.5">
        <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )
  }
</a>
