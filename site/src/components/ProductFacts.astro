---
/** "At a glance" strip of verified facts. Renders nothing without facts. */
interface Props {
  facts: ReadonlyArray<{ label: string; value: string }>;
  name: string;
}
import { i18n } from '@/i18n';
const { facts, name } = Astro.props;
const { t } = i18n(Astro);
---

{
  facts.length > 0 && (
    <section class="facts border-y border-line bg-ink-deep" aria-labelledby="facts-title">
      <div class="container-x py-10 md:py-12">
        <h2 id="facts-title" class="eyebrow mb-6">
          {t('showcase.glance', { name })}
        </h2>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-6 sm:grid-cols-4">
          {facts.map((f) => (
            <div class="fact">
              <dt class="text-xs tracking-[0.04em] text-subtle uppercase">{f.label}</dt>
              <dd class="fact-value mt-1.5 font-display text-[1.0625rem] leading-snug font-medium tracking-[-0.01em] text-text">{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  .fact {
    padding-left: 0.9rem;
    border-left: 2px solid transparent;
    border-image: linear-gradient(to bottom, var(--accent), var(--accent-alt)) 1;
  }
</style>
