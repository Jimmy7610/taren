---
/** System requirements as a clean two-column list (verified values only). */
interface Props {
  items: ReadonlyArray<{ label: string; value: string }>;
}
const { items } = Astro.props;
---

<dl class="reqs overflow-hidden rounded-(--radius-card) border border-line">
  {
    items.map((r) => (
      <div class="req grid gap-1 px-6 py-4 sm:grid-cols-[12rem_1fr] sm:gap-6">
        <dt class="text-sm text-subtle">{r.label}</dt>
        <dd class="text-[0.9375rem] leading-relaxed text-text">{r.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .reqs {
    background: var(--color-surface);
  }
  .req + .req {
    border-top: 1px solid var(--color-line);
  }
</style>
