---
import BrandMark from './BrandMark.astro';
import { KOFI_URL, LEGAL_NAV, PRIMARY_NAV, SITE } from '@/config/site';
---

<footer class="relative mt-auto border-t border-line bg-ink-deep" id="site-footer">
  <div class="container-x grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr] md:py-20">
    <div class="max-w-sm">
      <a href="/" class="-m-2 inline-flex min-h-11 items-center p-2" aria-label="Taren — home"><BrandMark height={44} eager={false} /></a>
      <p class="mt-5 text-muted">{SITE.tagline}</p>
      <p class="mt-2 text-sm text-subtle">An independent software studio in {SITE.country}.</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="eyebrow mb-4 text-subtle!">Explore</h2>
      <ul class="space-y-1">
        <li><a href="/" class="footer-link">Home</a></li>
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow mb-4 text-subtle!">Legal &amp; support</h2>
      <ul class="space-y-1">
        {
          LEGAL_NAV.map((item) => (
            <li>
              <a href={item.href} class="footer-link">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={KOFI_URL} target="_blank" rel="noopener noreferrer" class="footer-link" data-kofi-link>
            Ko-fi<span aria-hidden="true">&nbsp;↗</span><span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="container-x flex flex-col gap-2 border-t border-line py-6 text-sm text-subtle sm:flex-row sm:justify-between">
    <p data-copyright>{SITE.copyright}</p>
    <p>Made in {SITE.country}.</p>
  </div>
</footer>

<style>
  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-muted);
    transition: color 0.2s;
  }
  .footer-link:hover {
    color: var(--color-text);
  }
</style>
