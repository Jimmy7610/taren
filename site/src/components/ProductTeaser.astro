---
/** Compact link to a featured product (hero on phones/tablets, mobile menu). Real data only. */
import { Picture } from 'astro:assets';
import { i18n } from '@/i18n';
import type { ProductData } from '@/lib/catalog';

interface Props {
  product: ProductData;
  label?: string;
  class?: string;
  eager?: boolean;
}
const { product, label, class: className = '', eager = false } = Astro.props;
const { t, path: lp } = i18n(Astro);
const kicker = label ?? `${t(`category.${product.category}`)} · ${t(`status.${product.status}`)}`;
---

<a
  href={lp(`/products/${product.slug}/`)}
  class:list={['teaser ring-brand group flex items-center gap-4 rounded-(--radius-card) border border-line p-3 pr-4', className]}
  data-accent={product.slug}
  data-teaser={product.slug}
>
  {
    product.icon && (
      <Picture
        src={product.icon}
        alt=""
        widths={[56, 112, 168]}
        sizes="56px"
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        loading={eager ? 'eager' : 'lazy'}
        class="size-14 shrink-0 rounded-2xl"
      />
    )
  }
  <span class="min-w-0 flex-1">
    <span class="block text-xs text-subtle">{kicker}</span>
    <span class="mt-0.5 block font-display text-lg leading-tight font-semibold tracking-[-0.015em] text-text">{product.name}</span>
    <span class="mt-0.5 block truncate text-sm text-muted">{product.tagline}</span>
  </span>
  <svg aria-hidden="true" viewBox="0 0 16 16" class="size-4 shrink-0 text-muted transition-transform duration-300 group-hover:translate-x-1 group-hover:text-text"
    ><path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg
  >
</a>

<style>
  .teaser {
    background:
      radial-gradient(ellipse 70% 120% at 0% 50%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%),
      rgb(18 27 49 / 0.72);
    transition:
      border-color 0.3s,
      transform 0.5s var(--ease-out-expo);
  }
  .teaser:hover {
    border-color: var(--color-line-strong);
  }
</style>
