---
/** Optional, low-key support section. Never a gate, never a popup. */
import Button from './Button.astro';
import { KOFI_URL } from '@/config/site';
import Swoosh from './Swoosh.astro';

interface Props {
  headingLevel?: 'h2' | 'h3';
  showLearnMore?: boolean;
}
import { i18n } from '@/i18n';
const { headingLevel: H = 'h2', showLearnMore = true } = Astro.props;
const { t, path: lp } = i18n(Astro);
---

<section aria-labelledby="support-cta-title" class="container-x" data-reveal>
  <div class="support-panel surface-grain relative overflow-hidden rounded-(--radius-panel) border border-line px-6 py-12 sm:px-12 md:py-16">
    <Swoosh id="support-arc" class="support-arc pointer-events-none absolute" />
    <div class="relative grid items-end gap-10 md:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="eyebrow mb-4">{t('supportCta.eyebrow')}</p>
        <H id="support-cta-title" class="text-headline text-text">{t('supportCta.title')}</H>
        <p class="mt-5 max-w-xl text-lead text-muted">
          {t('supportCta.text')}
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row md:flex-col md:items-end">
        <Button href={KOFI_URL} external size="lg" data-kofi-link>{t('kofi.cta')}</Button>
        {
          showLearnMore && (
            <Button href={lp('/support/')} variant="ghost" size="lg">
              {t('supportCta.learnMore')}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .support-panel {
    background:
      radial-gradient(ellipse 60% 90% at 100% 100%, rgb(99 12 225 / 0.18), transparent 60%),
      radial-gradient(ellipse 45% 70% at 100% 0%, rgb(227 4 251 / 0.08), transparent 60%),
      radial-gradient(ellipse 50% 80% at 0% 0%, rgb(1 227 252 / 0.08), transparent 60%),
      var(--color-surface);
  }
  :global(.support-arc) {
    right: -8%;
    bottom: -10%;
    width: min(46rem, 90%);
    height: auto;
    aspect-ratio: 600 / 160;
    opacity: 0.16;
  }
</style>
