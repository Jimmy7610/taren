---
/**
 * "A Taren App" — shows the product's own About screen with the Taren credit. The product keeps
 * its own name and icon; Taren appears as the studio behind it.
 */
import DeviceFrame from './DeviceFrame.astro';
import BrandMark from './BrandMark.astro';
import ExternalLink from './ExternalLink.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  device: 'phone' | 'desktop';
  about: { image: ImageMetadata; alt: string; caption?: string | undefined };
}
const { name, device, about } = Astro.props;
---

<section class="attribution container-x grid items-center gap-10 py-20 md:py-28 lg:grid-cols-[1fr_1.25fr] lg:gap-16" aria-labelledby="attribution-title">
  <div>
    <div class="flex items-center gap-3">
      <BrandMark variant="symbol" height={28} eager={false} />
      <p class="eyebrow">A Taren App</p>
    </div>
    <h2 id="attribution-title" class="mt-5 text-headline text-text">Made by Taren</h2>
    <p class="measure-lead mt-5 text-lead text-muted">
      {name} keeps its own name and icon. Its About screen credits the studio behind it — the official Taren symbol,
      “A Taren App” and a link to taren.se.
    </p>
    <p class="mt-6 text-sm text-subtle">
      More about the studio: <a href="/studio/" class="text-cyan-soft underline underline-offset-4 hover:text-text">Studio</a> ·
      <ExternalLink href="https://taren.se/" class="text-cyan-soft underline underline-offset-4 hover:text-text">taren.se</ExternalLink>
    </p>
  </div>
  <figure data-reveal>
    <DeviceFrame
      device={device}
      src={about.image}
      alt={about.alt}
      sizes={device === 'desktop' ? '(min-width: 1024px) 620px, 92vw' : '(min-width: 1024px) 300px, 70vw'}
    />
    {about.caption && <figcaption class="mt-4 text-sm text-muted">{about.caption}</figcaption>}
  </figure>
</section>
