---
/**
 * A restrained desktop-window frame around a real application screenshot (landscape).
 * Pairs with PhoneFrame; choose between them with DeviceFrame.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
  class?: string;
}
const { src, alt, sizes, widths = [480, 720, 1000, 1400], loading = 'lazy', fetchpriority = 'auto', class: className = '' } = Astro.props;
---

<div class:list={['desktop', className]}>
  <Picture
    src={src}
    alt={alt}
    widths={widths.filter((w) => w <= src.width)}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    loading={loading}
    decoding={loading === 'eager' ? 'sync' : 'async'}
    fetchpriority={fetchpriority}
    class="desktop-screen"
  />
</div>

<style>
  .desktop {
    position: relative;
    padding: 0.3rem;
    border-radius: 0.9rem;
    background: linear-gradient(160deg, #2a3655, #0f1729 50%, #1c2744);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.09) inset,
      0 40px 80px -36px rgb(0 0 0 / 0.8),
      0 24px 70px -44px color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .desktop :global(img),
  .desktop :global(.desktop-screen) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.65rem;
    background: var(--color-ink-deep);
  }
</style>
