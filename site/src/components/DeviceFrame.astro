---
/** Chooses the phone or desktop frame for a product's screenshots. */
import PhoneFrame from './PhoneFrame.astro';
import DesktopFrame from './DesktopFrame.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  device: 'phone' | 'desktop';
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
  class?: string;
}
const { device, ...rest } = Astro.props;
---

{device === 'desktop' ? <DesktopFrame {...rest} /> : <PhoneFrame {...rest} />}
