---
/**
 * ProductGallery — a horizontally scrolling row of real screenshots (scroll-snap, keyboard
 * scrollable) with an accessible lightbox.
 *
 * Progressive enhancement: every screenshot is a link to its full-size image, so it works without
 * JavaScript. With JavaScript the link opens a native modal <dialog>: focus is contained, Escape
 * closes, ←/→ (and swipe) move between screenshots, the counter is announced, and focus returns to
 * the screenshot that opened it.
 */
import { getImage } from 'astro:assets';
import DeviceFrame from './DeviceFrame.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  items: ReadonlyArray<{ image: ImageMetadata; alt: string; caption?: string | undefined }>;
  label: string;
  device?: 'phone' | 'desktop';
}
import { i18n } from '@/i18n';
const { items, label, device = 'phone' } = Astro.props;
const { t } = i18n(Astro);
const id = `gallery-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;

const full = await Promise.all(
  items.map(async (it) => {
    const width = Math.min(device === 'desktop' ? 1400 : 786, it.image.width);
    const [avif, webp] = await Promise.all([
      getImage({ src: it.image, width, format: 'avif' }),
      getImage({ src: it.image, width, format: 'webp' }),
    ]);
    return { avif: avif.src, webp: webp.src, width, height: Math.round((it.image.height / it.image.width) * width) };
  }),
);
---

{
  items.length > 0 && (
    <div
      class:list={['gallery-wrap', `is-${device}`]}
      data-gallery
      data-at-start
      data-t-count={t('gallery.count', { total: '{total}' })}
      data-t-range={t('gallery.range', { from: '{from}', to: '{to}', total: '{total}' })}
      data-t-single={t('gallery.single', { from: '{from}', total: '{total}' })}
    >
      <div class="gallery-viewport">
      <div class="gallery" tabindex="0" role="region" aria-label={label} id={`${id}-region`} aria-describedby={`${id}-hint`}>
        <ul class="gallery-track">
          {items.map((item, i) => (
            <li class="gallery-item">
              <figure>
                <a
                  href={full[i]!.webp}
                  class="shot-link ring-brand"
                  data-index={i}
                  data-avif={full[i]!.avif}
                  data-webp={full[i]!.webp}
                  data-w={full[i]!.width}
                  data-h={full[i]!.height}
                  data-alt={item.alt}
                  data-caption={item.caption ?? ''}
                >
                  <DeviceFrame
                    device={device}
                    src={item.image}
                    alt={item.alt}
                    sizes={device === 'desktop' ? '(min-width: 768px) 560px, 86vw' : '(min-width: 768px) 260px, 62vw'}
                    widths={device === 'desktop' ? [480, 720, 1000, 1400] : [240, 360, 520, 786]}
                  />
                  <span class="sr-only">{t('gallery.open')}</span>
                  <span class="zoom" aria-hidden="true">
                    <svg viewBox="0 0 16 16" class="size-4">
                      <path d="M10 2h4v4M14 2l-5 5M6 14H2v-4M2 14l5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
                {item.caption && <figcaption class="mt-4 text-sm text-muted">{item.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      </div>
      </div>
      <div class="container-x gallery-controls">
        <p class="text-sm text-subtle" id={`${id}-hint`}>
          <span class="tnum" data-gallery-status>{t('gallery.count', { total: items.length })}</span>
          <span aria-hidden="true"> · </span>
          <span class="hint-touch">{t('gallery.hintTouch')}</span>
          <span class="hint-fine">{t('gallery.hintFine')}</span>
        </p>
        <div class="gallery-nav" data-gallery-nav hidden>
          <button type="button" class="nav-btn" data-gallery-prev aria-controls={`${id}-region`}>
            <span class="sr-only">{t('gallery.prev')}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5">
              <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" class="nav-btn" data-gallery-next aria-controls={`${id}-region`}>
            <span class="sr-only">{t('gallery.next')}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5">
              <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>

      <dialog class="lightbox" aria-label={t('gallery.viewer', { label })} data-lightbox>
        <div class="lb-shell">
          <div class="lb-bar">
            <p class="lb-count tnum" aria-live="polite" data-lb-count />
            <button type="button" class="lb-btn" data-lb-close>
              <span class="sr-only">{t('gallery.close')}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5">
                <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
            </button>
          </div>
          <figure class="lb-figure">
            <picture>
              <source type="image/avif" data-lb-avif />
              <img alt="" data-lb-img decoding="async" />
            </picture>
            <figcaption class="lb-caption" data-lb-caption />
          </figure>
          <button type="button" class="lb-btn lb-prev" data-lb-prev>
            <span class="sr-only">{t('gallery.prevShot')}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5">
              <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button type="button" class="lb-btn lb-next" data-lb-next>
            <span class="sr-only">{t('gallery.nextShot')}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5">
              <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </dialog>
    </div>
  )
}

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Scroller navigation: previous/next buttons, a position read-out and edge state for the fades.
  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const scroller = root.querySelector<HTMLElement>('.gallery');
    const nav = root.querySelector<HTMLElement>('[data-gallery-nav]');
    const status = root.querySelector<HTMLElement>('[data-gallery-status]');
    const items = [...root.querySelectorAll<HTMLElement>('.gallery-item')];
    if (!scroller || !nav || !status || items.length === 0) continue;
    const prev = nav.querySelector<HTMLButtonElement>('[data-gallery-prev]')!;
    const next = nav.querySelector<HTMLButtonElement>('[data-gallery-next]')!;
    const total = items.length;

    // Index of the first item whose left edge is at or past the scroll-snap start.
    const firstVisible = () => {
      const start = scroller.getBoundingClientRect().left + parseFloat(getComputedStyle(scroller).scrollPaddingLeft || '0');
      const i = items.findIndex((it) => it.getBoundingClientRect().left >= start - 8);
      return i === -1 ? total - 1 : i;
    };
    const lastVisible = () => {
      const right = scroller.getBoundingClientRect().right;
      let last = 0;
      items.forEach((it, i) => {
        if (it.getBoundingClientRect().right <= right + 8) last = i;
      });
      return last;
    };
    const update = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      const atStart = scroller.scrollLeft <= 4;
      const atEnd = scroller.scrollLeft >= max - 4;
      root.toggleAttribute('data-at-start', atStart);
      root.toggleAttribute('data-at-end', atEnd);
      // aria-disabled (not disabled) so a focused button keeps focus at either end.
      prev.setAttribute('aria-disabled', String(atStart));
      next.setAttribute('aria-disabled', String(atEnd));
      const a = firstVisible() + 1;
      const b = atEnd ? total : Math.max(a, lastVisible() + 1);
      const fill = (tpl: string | undefined, v: Record<string, number>) =>
        (tpl ?? '').replace(/\{(\w+)\}/g, (_, k: string) => String(v[k] ?? ''));
      status.textContent =
        max <= 4
          ? fill(root.dataset.tCount, { total })
          : a === b
            ? fill(root.dataset.tSingle, { from: a, total })
            : fill(root.dataset.tRange, { from: a, to: b, total });
      nav.hidden = max <= 4;
    };
    // While a smooth scroll is running, repeated presses step from where it is heading, not from
    // where it currently is, so no press is lost.
    let pending: number | null = null;
    let idle = 0;
    const go = (dir: 1 | -1) => {
      if ((dir < 0 ? prev : next).getAttribute('aria-disabled') === 'true') return;
      const index = Math.min(total - 1, Math.max(0, (pending ?? firstVisible()) + dir));
      const target = items[index]!;
      const offset = target.getBoundingClientRect().left - scroller.getBoundingClientRect().left;
      const pad = parseFloat(getComputedStyle(scroller).scrollPaddingLeft || '0');
      const max = scroller.scrollWidth - scroller.clientWidth;
      const left = Math.min(max, Math.max(0, scroller.scrollLeft + offset - pad));
      pending = index;
      scroller.scrollTo({ left, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      settle();
    };
    const settle = () => {
      clearTimeout(idle);
      idle = window.setTimeout(() => {
        pending = null;
        update();
      }, 180);
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    let frame = 0;
    scroller.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
        if (pending !== null) settle();
      },
      { passive: true },
    );
    new ResizeObserver(update).observe(scroller);
    update();
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]');
    const links = [...root.querySelectorAll<HTMLAnchorElement>('.shot-link')];
    if (!dialog || links.length === 0) continue;
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const avif = dialog.querySelector<HTMLSourceElement>('[data-lb-avif]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const d = links[index]!.dataset;
      avif.srcset = d.avif ?? '';
      img.src = d.webp ?? '';
      img.width = Number(d.w);
      img.height = Number(d.h);
      img.alt = d.alt ?? '';
      caption.textContent = d.caption ?? '';
      caption.hidden = !d.caption;
      count.textContent = `${index + 1} / ${links.length}`;
    };

    links.forEach((link, i) =>
      link.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return; // allow open-in-new-tab
        e.preventDefault();
        opener = link;
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(index + 1);
      }
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close(); // backdrop
    });
    let startX = 0;
    dialog.addEventListener('pointerdown', (e) => (startX = e.clientX));
    dialog.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50 && e.pointerType !== 'mouse') show(index + (dx < 0 ? 1 : -1));
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('menu-open');
      // Scroll the opener into view without jumping, then return focus to it.
      const target = links[index] ?? opener;
      target?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      target?.focus();
    });
    new MutationObserver(() => document.documentElement.classList.toggle('menu-open', dialog.open)).observe(dialog, {
      attributes: true,
      attributeFilter: ['open'],
    });
  }
</script>

<style>
  .gallery {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100vw - 78rem) / 2 + var(--gutter)));
    padding: 0.5rem max(var(--gutter), calc((100vw - 78rem) / 2 + var(--gutter))) 1.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-line-strong) transparent;
  }
  /* Edge fades hint that the row continues; they track the scroll position (data-at-start/-end). */
  .gallery-viewport {
    position: relative;
  }
  .gallery-viewport::before,
  .gallery-viewport::after {
    content: '';
    position: absolute;
    top: 0;
    z-index: 1;
    width: clamp(1.5rem, 6vw, 5rem);
    bottom: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }
  .gallery-viewport::before {
    left: 0;
    background: linear-gradient(to right, var(--color-ink-deep), transparent);
  }
  .gallery-viewport::after {
    right: 0;
    background: linear-gradient(to left, var(--color-ink-deep), transparent);
  }
  .gallery-wrap[data-at-start] .gallery-viewport::before,
  .gallery-wrap[data-at-end] .gallery-viewport::after {
    opacity: 0;
  }
  .gallery-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1rem;
  }
  .hint-fine {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hint-touch {
      display: none;
    }
    .hint-fine {
      display: inline;
    }
  }
  .gallery-nav {
    display: flex;
    gap: 0.5rem;
  }
  .gallery-nav[hidden] {
    display: none;
  }
  .nav-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-text);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid var(--color-line-strong);
    transition:
      background-color 0.2s,
      opacity 0.2s;
  }
  .nav-btn:hover:not([aria-disabled='true']) {
    background: rgb(255 255 255 / 0.12);
  }
  .nav-btn[aria-disabled='true'] {
    opacity: 0.4;
    cursor: default;
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-viewport::before,
    .gallery-viewport::after,
    .nav-btn {
      transition: none;
    }
  }
  .gallery-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(64vw, 16.25rem);
    gap: clamp(1rem, 3vw, 2rem);
    width: max-content;
  }
  .gallery:focus-visible {
    outline-offset: -2px;
    border-radius: 0;
  }
  .gallery-item {
    scroll-snap-align: start;
  }
  .is-desktop .gallery-track {
    grid-auto-columns: min(86vw, 35rem);
  }
  .is-desktop .shot-link,
  .is-desktop .shot-link:focus-visible {
    border-radius: 0.9rem;
  }
  .is-desktop .lb-figure img {
    max-width: min(100%, 78rem);
    border-radius: 0.75rem;
  }
  .shot-link {
    display: block;
    border-radius: 2.1rem;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .shot-link:hover {
    transform: translateY(-4px);
  }
  .shot-link:focus-visible {
    outline-offset: 4px;
    border-radius: 2.1rem;
  }
  .zoom {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--color-text);
    background: rgb(7 11 23 / 0.72);
    border: 1px solid var(--color-line-strong);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .shot-link:hover .zoom,
  .shot-link:focus-visible .zoom {
    opacity: 1;
  }
  @media (hover: none) {
    .zoom {
      opacity: 1;
    }
  }

  .lightbox {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-text);
    background: rgb(7 11 23 / 0.94);
  }
  .lightbox::backdrop {
    background: rgb(7 11 23 / 0.6);
  }
  .lightbox[open] {
    animation: lb-in 0.35s var(--ease-out-quart);
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-shell {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    padding: max(0.75rem, env(safe-area-inset-top)) var(--gutter) max(1rem, env(safe-area-inset-bottom));
  }
  .lb-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
  }
  .lb-count {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .lb-figure {
    display: flex;
    min-height: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .lb-figure picture {
    display: contents;
  }
  .lb-figure img {
    min-height: 0;
    max-height: calc(100dvh - 9rem);
    width: auto;
    max-width: min(100%, 26rem);
    border-radius: 1.6rem;
    box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.9);
  }
  .lb-caption {
    max-width: 32rem;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }
  .lb-btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-text);
    background: rgb(255 255 255 / 0.06);
    border: 1px solid var(--color-line-strong);
    transition: background-color 0.2s;
  }
  .lb-btn:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .lb-prev,
  .lb-next {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
  }
  .lb-prev {
    left: var(--gutter);
  }
  .lb-next {
    right: var(--gutter);
  }
  @media (max-width: 40rem) {
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: max(1rem, env(safe-area-inset-bottom));
      translate: none;
    }
    .lb-figure img {
      max-height: calc(100dvh - 12rem);
    }
  }
</style>
