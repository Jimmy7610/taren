---
import Button from './Button.astro';

interface Props {
  code: string;
  title: string;
  message: string;
}
const { code, title, message } = Astro.props;
---

<section class="relative isolate overflow-hidden" aria-labelledby="error-title">
  <div class="grid-field pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-x flex min-h-[calc(100dvh-var(--header-h)-1px)] flex-col items-start justify-center py-24">
    <p class="error-code font-display font-semibold" aria-hidden="true">{code}</p>
    <h1 id="error-title" class="mt-2 text-headline text-text">{title}</h1>
    <p class="mt-5 max-w-xl text-lead text-muted">{message}</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href="/">Back to home</Button>
      <Button href="/products/" variant="secondary">See products</Button>
    </div>
  </div>
</section>

<style>
  .error-code {
    font-size: clamp(5rem, 18vw, 11rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    background: var(--gradient-brand-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
