---
/**
 * CrossfadePhone — a device frame that slowly cross-fades through up to three real screenshots.
 * CSS only (opacity on the compositor). With prefers-reduced-motion the first screenshot stays.
 * The first image carries the description; the others are decorative repeats of gallery images.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  shots: ReadonlyArray<{ image: ImageMetadata; alt: string }>;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { shots, sizes, eager = false, class: className = '' } = Astro.props;
const frames = shots.slice(0, 3);
const widths = [280, 400, 560, 786];
---

<div class:list={['xphone', `n-${frames.length}`, className]}>
  <div class="screen">
    {
      frames.map((shot, i) => (
        <Picture
          src={shot.image}
          alt={i === 0 ? shot.alt : ''}
          aria-hidden={i === 0 ? undefined : 'true'}
          widths={widths.filter((w) => w <= shot.image.width)}
          sizes={sizes}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading={eager && i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class={`frame frame-${i}`}
        />
      ))
    }
  </div>
</div>

<style>
  .xphone {
    position: relative;
    padding: 0.45rem;
    border-radius: 2.3rem;
    background: linear-gradient(160deg, #2a3655, #0f1729 45%, #1c2744);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.09) inset,
      0 50px 90px -34px rgb(0 0 0 / 0.8),
      0 30px 80px -40px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  .screen {
    position: relative;
    aspect-ratio: 786 / 1704;
    overflow: hidden;
    border-radius: 1.85rem;
    background: var(--color-ink-deep);
  }
  .screen :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .screen :global(.frame-1),
  .screen :global(.frame-2) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .n-2 .screen :global(.frame-1) {
      animation: xfade-2 10s ease-in-out infinite;
    }
    .n-3 .screen :global(.frame-1) {
      animation: xfade-3a 13.5s ease-in-out infinite;
    }
    .n-3 .screen :global(.frame-2) {
      animation: xfade-3b 13.5s ease-in-out infinite;
    }
  }
  /* Two frames: second shows for the latter half. */
  @keyframes xfade-2 {
    0%,
    42% {
      opacity: 0;
    }
    50%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  /* Three frames: each holds ~4.5 s; frame 0 is always underneath. */
  @keyframes xfade-3a {
    0%,
    28% {
      opacity: 0;
    }
    34%,
    95% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes xfade-3b {
    0%,
    61% {
      opacity: 0;
    }
    67%,
    95% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
