---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCard from '@/components/ProductCard.astro';
import ProductShowcase from '@/components/ProductShowcase.astro';
import { getPublicProducts } from '@/lib/catalog';
import { breadcrumbJsonLd } from '@/lib/seo';

const products = await getPublicProducts();
---

<BaseLayout
  title="Products"
  description="Applications, games and experiments from Taren, an independent software studio in Sweden. Each product has its own page and an honest status."
  jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Products', path: '/products/' }])]}
>
  <section class="relative isolate overflow-hidden border-b border-line" aria-labelledby="products-title">
    <div class="grid-field pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-x section-y">
      <SectionHeading eyebrow="Products" title="Selected work" id="products-title" level="h1">
        <p>
          Every product has its own page with an honest status. Released means you can get it today; in development
          means it is real, being built, and not finished yet.
        </p>
      </SectionHeading>
    </div>
  </section>

  <section class="container-x pt-12 section-b md:pt-16" aria-label="Product list">
    {
      products[0] ? (
        <>
          {/* The first product in catalogue order gets the full-width stage; the rest follow in a two-column grid. */}
          <ProductShowcase product={products[0]} headingLevel="h2" eager />
          {products.length > 1 ? (
            <ul class="mt-6 grid gap-6 md:grid-cols-2" role="list" aria-label="More products">
              {products.slice(1).map((p, i) => (
                <li class="flex *:w-full">
                  <ProductCard product={p} headingLevel="h2" eager={i < 2} />
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-8 text-sm text-subtle">
              More projects are in the workshop. They will appear here when there is something real to show — not before.
            </p>
          )}
        </>
      ) : (
        <p class="text-lead text-muted">The first products will appear here when they are ready to show.</p>
      )
    }
  </section>
</BaseLayout>
